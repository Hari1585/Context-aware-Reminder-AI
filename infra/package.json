{
  "name": "reminder-app-infra",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy:dev": "cdk deploy --all --context env=dev --require-approval never",
    "deploy:stage": "cdk deploy --all --context env=stage --require-approval never",
    "deploy:prod": "cdk deploy --all --context env=prod --require-approval broadening",
    "diff": "cdk diff --all",
    "synth": "cdk synth --all"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "aws-cdk": "^2.120.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.120.0",
    "constructs": "^10.3.0"
  }
}
