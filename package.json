{
  "name": "reminder-app",
  "version": "1.0.0",
  "description": "Context-Aware Location-Based Reminder AI on AWS",
  "private": true,
  "workspaces": [
    "infra",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && cd infra && npm install && cd ../frontend && npm install",
    "test:backend": "cd backend && pytest tests/ -v",
    "deploy:dev": "cd infra && npm run deploy:dev",
    "deploy:stage": "cd infra && npm run deploy:stage",
    "deploy:prod": "cd infra && npm run deploy:prod"
  },
  "keywords": [
    "aws",
    "serverless",
    "lambda",
    "dynamodb",
    "cognito",
    "location",
    "reminders",
    "ai",
    "nlp"
  ],
  "author": "",
  "license": "MIT"
}
